# Select the transport explicitly. See docs/providers.md.
JEVS_PROVIDER=typesafe
JEVS_API_KEY=
# JEVS_DEFAULT_MODEL=jev-latest
# JEVS_BASE_URL=https://api.typesafe.ai
# JEVS_REQUEST_TIMEOUT_MS=30000

# Native OpenAI Decisions public beta:
# JEVS_PROVIDER=openai
# JEVS_DEFAULT_MODEL=gpt-6-luna
# JEVS_API_KEY must be an OpenAI API key; no provider-specific key alias is read.

# Existing protocol on an explicitly configured endpoint:
# JEVS_PROVIDER=custom
# JEVS_PROTOCOL=tev1-chat
# JEVS_BASE_URL=http://localhost:8080
# JEVS_DEFAULT_MODEL=local/tev1
# JEVS_PROTOCOL applies only to custom; clear it when switching providers.

# Native Clef: JEVS_PROVIDER=cloudflare-workers
# CLOUDFLARE_ACCOUNT_ID=
# JEVS_DEFAULT_MODEL=@cf/cloudflare/clef-flash
# Optional for Cloudflare Workers and the unified Gateway:
# CLOUDFLARE_AI_GATEWAY_ID=

# JEVS_MAX_CONCURRENCY=4
# JEVS_MAX_QUEUE=32
# JEVS_QUEUE_TIMEOUT_MS=1000

# Unknown model IDs are blocked by default, even when the protocol is known.
# Permit deliberately tested future/custom models with a per-call
# allowUnverifiedModel: true, or this explicit host default:
# JEVS_ALLOW_UNVERIFIED_MODELS=false

# Self-hosted Clef via an operator-selected Python environment (no HTTP key):
# JEVS_PROVIDER=clef-python
# JEVS_PYTHON_MODEL_DIR=/path/to/trusted/clef-release
# JEVS_PYTHON_EXECUTABLE=python3
# JEVS_DEFAULT_MODEL=clef
# Requires local official model code/weights and its Python dependencies.
# Initial model loading may need a larger JEVS_REQUEST_TIMEOUT_MS.
