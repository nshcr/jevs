# Endpoint and credential setup: docs/providers.md
TYPESAFE_API_KEY=replace-with-your-api-key
# Optional override; otherwise selected from the configured endpoint
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional Cloudflare AI Gateway selection; otherwise account default
# CLOUDFLARE_AI_GATEWAY_ID=default

# Local admission limits, independent of provider quotas
# JEVS_MAX_CONCURRENCY=4
# JEVS_MAX_QUEUE=32
# JEVS_QUEUE_TIMEOUT_MS=1000
